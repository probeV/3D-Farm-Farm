# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않음)

# 비밀 키 생성:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

# 개발 중에는 True, 다른 사람에게 공개하는 서버에서는 False
DJANGO_DEBUG=True

# 접속을 허용할 주소 (같은 와이파이의 폰에서 접속하려면 PC 의 내부 IP 추가, 예: 192.168.0.10)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
